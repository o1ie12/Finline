# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local dev-only data store (see lib/db.ts)
.devstore.json
.devstore.json.*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 05 playtest screenshots stay local (the report is committed)
/docs/playtest-05/screens-390x844/
/docs/design/screens/

# Private notes against partner material (06 G6): never committed.
docs/design/private/

# The same local-only folders at their new home (docs moved to docs/archive, 2026-11-17).
/docs/archive/playtest-05/screens-390x844/
/docs/archive/design/screens/
docs/archive/design/private/

# A person's own Claude Code permissions. The shared dev-server config (.claude/launch.json) stays tracked.
.claude/settings.local.json
